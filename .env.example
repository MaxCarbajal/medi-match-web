# Backend de proveedores/reservas (medi-match-api). En dev, uvicorn en localhost:8000;
# en producción, la URL del deploy en Vercel.
VITE_API_BASE_URL="http://localhost:8000"

# Proyecto Supabase (usado por src/integrations/supabase para auth). El publishable
# key es público por diseño (empieza con sb_publishable_), seguro de commitear.
SUPABASE_PROJECT_ID="tu-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
SUPABASE_URL="https://tu-project-id.supabase.co"
VITE_SUPABASE_PROJECT_ID="tu-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_URL="https://tu-project-id.supabase.co"
